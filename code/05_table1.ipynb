      "source": [
        "import pandas as pd\n",
        "\n",
        "# 실습자료 csv 파일을 파이썬 pandas로 읽어오기 (불러오기)\n",
        "# 업로드된 실제 파일명 'knhanes_like_week4.csv'로 경로를 수정했습니다.\n",
        "df = pd.read_csv('knhanes_like_week4.csv')\n",
        "\n",
       
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# 1. 무응답 코드(9) NaN 처리\n",
        "df[\"edu_clean\"] = df[\"edu\"].replace(9, np.nan)\n",
        "df[\"income_clean\"] = df[\"income\"].replace(9, np.nan)\n",
        "\n",
        "\n",
        "# 가중 중앙값 및 IQR 계산 함수\n",
        "def weighted_quantile(values, quantiles, sample_weight):\n",
        "    values = np.array(values)\n",
        "    quantiles = np.array(quantiles)\n",
        "    sample_weight = np.array(sample_weight)\n",
        "\n",
        "    valid = ~np.isnan(values) & ~np.isnan(sample_weight)\n",
        "    values = values[valid]\n",
        "    sample_weight = sample_weight[valid]\n",
        "\n",
        "    sorter = np.argsort(values)\n",
        "    values = values[sorter]\n",
        "    sample_weight = sample_weight[sorter]\n",
        "\n",
        "    weighted_quantiles = np.cumsum(sample_weight) - 0.5 * sample_weight\n",
        "    weighted_quantiles /= np.sum(sample_weight)\n",
        "    return np.interp(quantiles, weighted_quantiles, values)\n",
        "\n",
        "\n",
        "# 복합표본 도메인 분석 함수 (가중치 적용)\n",
        "def calc_weighted_stats(sub_df):\n",
        "    w = sub_df[\"wt\"]\n",
        "    n_total = len(sub_df)\n",
        "\n",
        "    # 연속형 (평균, SE)\n",
        "    def mean_se(var):\n",
        "        val = sub_df[var].dropna()\n",
        "        weight = w.loc[val.index]\n",
        "        m = np.average(val, weights=weight)\n",
        "        # 단순 가중 표준오차 계산 (도메인 추정용)\n",
        "        se = np.sqrt(np.average((val - m) ** 2, weights=weight) / len(val))\n",
        "        return f\"{m:.1f} ({se:.2f})\"\n",
        "\n",
        "    # 연속형 (중앙값, IQR - 왜도 큰 변수)\n",
        "    def median_iqr(var):\n",
        "        val = sub_df[var].dropna()\n",
        "        weight = w.loc[val.index]\n",
        "        q25, q50, q75 = weighted_quantile(val, [0.25, 0.50, 0.75], weight)\n",
        "        return f\"{q50:.1f} ({q25:.1f}-{q75:.1f})\"\n",
        "\n",
        "    # 범주형 (n, 가중%)\n",
        "    def cat_pct(var, val_code):\n",
        "        valid_df = sub_df.dropna(subset=[var])\n",
        "        n = (valid_df[var] == val_code).sum()\n",
        "        pct = (\n",
        "            sub_df.loc[sub_df[var] == val_code, \"wt\"].sum()\n",
        "            / sub_df.loc[sub_df[var].notna(), \"wt\"].sum()\n",
        "            * 100\n",
        "        )\n",
        "        return f\"{n:,} ({pct:.1f}%)\"\n",
        "\n",
        "    res = {}\n",
        "    res[\"n\"] = n_total\n",
        "    res[\"age\"] = mean_se(\"age\")\n",
        "    res[\"sex_male\"] = cat_pct(\"sex\", 1)\n",
        "    res[\"urban_dong\"] = cat_pct(\"urban\", 1)\n",
        "    res[\"edu_high\"] = cat_pct(\"edu_clean\", 1)\n",
        "\n",
        "    for i in range(1, 5):\n",
        "        res[f\"income_{i}\"] = cat_pct(\"income_clean\", i)\n",
        "\n",
        "    res[\"bmi\"] = median_iqr(\"bmi\")\n",
        "    res[\"sbp\"] = mean_se(\"sbp\")\n",
        "    res[\"dbp\"] = mean_se(\"dbp\")\n",
        "    res[\"glucose\"] = median_iqr(\"glucose\")\n",
        "    res[\"chol\"] = mean_se(\"chol\")\n",
        "    res[\"htn\"] = cat_pct(\"hypertension\", 1) if \"hypertension\" in sub_df else \"N/A\"\n",
        "    res[\"smk\"] = cat_pct(\"smk\", 1)  # 현재흡연\n",
        "    res[\"drink\"] = cat_pct(\"drink\", 1)  # 고위험음주\n",
        "\n",
        "    return res\n",
        "\n",
        "\n",
        "# 비가중 분석 함수 (B-3 비교용)\n",
        "def calc_unweighted_stats(sub_df):\n",
        "    n_total = len(sub_df)\n",
        "\n",
        "    def mean_val(var):\n",
        "        return f\"{sub_df[var].mean():.1f}\"\n",
        "\n",
        "    def cat_pct_unw(var, val_code):\n",
        "        valid = sub_df[var].dropna()\n",
        "        n = (valid == val_code).sum()\n",
        "        pct = (n / len(valid)) * 100\n",
        "        return f\"{n:,} ({pct:.1f}%)\"\n",
        "\n",
        "    res = {}\n",
        "    res[\"age\"] = mean_val(\"age\")\n",
        "    res[\"urban_dong\"] = cat_pct_unw(\"urban\", 1)\n",
        "    for i in range(1, 5):\n",
        "        res[f\"income_{i}\"] = cat_pct_unw(\"income_clean\", i)\n",
        "    return res\n",
        "\n",
        "\n",
        "# 전체, 운동군(exercise==2), 비운동군(exercise==1) 나누어 계산\n",
        "df_ex2 = df[df[\"exercise\"] == 2]\n",
        "df_ex1 = df[df[\"exercise\"] == 1]\n",
        "\n",
        "t1_all = calc_weighted_stats(df)\n",
        "t1_ex2 = calc_weighted_stats(df_ex2)\n",
        "t1_ex1 = calc_weighted_stats(df_ex1)\n",
        "\n",
        "# 결과 출력\n",
        "print(\"=== [Table 1: 복합표본 가중 결과] ===\")\n",
        "t1_df = pd.DataFrame([t1_all, t1_ex2, t1_ex1], index=[\"전체\", \"운동군\", \"비운동군\"])\n",
        "display(t1_df.T)\n",
        "\n",
        "print(\"\\n=== [B-3 비교용: 비가중 결과] ===\")\n",
        "unw_df = pd.DataFrame(\n",
        "    [calc_unweighted_stats(df), calc_unweighted_stats(df_ex2), calc_unweighted_stats(df_ex1)],\n",
        "    index=[\"전체\", \"운동군\", \"비운동군\"],\n",
        ")\n",
        "display(unw_df.T)"
      ],
